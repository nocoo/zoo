{
  "name": "zoo",
  "version": "1.0.0",
  "description": "A gentle Chinese picture-learning island for little explorers.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/build-live.mjs && node scripts/build-pwa.mjs",
    "check": "node --experimental-strip-types scripts/check.ts",
    "check:live": "node scripts/check-live.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 7058",
    "deploy": "npm run build && wrangler deploy"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nocoo/zoo.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/nocoo/zoo/issues"
  },
  "homepage": "https://github.com/nocoo/zoo#readme",
  "dependencies": {
    "animal-island-ui": "^2.1.0",
    "classnames": "^2.5.1",
    "naive-icons": "^1.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "wrangler": "^4.147.0"
  },
  "private": true,
  "overrides": {
    "sharp": "0.35.5"
  }
}
